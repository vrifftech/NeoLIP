set(_neolip_models phonemes_new_16k.parts phonemes_new_16k.train.spec)
foreach(_kind manner place height)
    foreach(_suffix _nnet.45 .train.spec .map .parts)
        list(APPEND _neolip_models "bc_16k/${_kind}${_suffix}")
    endforeach()
    foreach(_suffix _nnet.45 .train.spec)
        list(APPEND _neolip_models "trans_16k/${_kind}${_suffix}")
    endforeach()
endforeach()
set(_neolip_resources "")
set(_neolip_hashes "")
set(_neolip_asset_files "")
foreach(_relative IN LISTS _neolip_models)
    set(_source "${NEOLIP_CSLU_FA_DIR}/${_relative}")
    file(SHA256 "${_source}" _hash)
    string(APPEND _neolip_hashes "models/${_relative}:${_hash}\n")
    string(MAKE_C_IDENTIFIER "@neolip/models/${_relative}" _name)
    string(TOUPPER "${_name}" _name)
    string(APPEND _neolip_resources "${_name} RCDATA \"${_source}\"\n")
    list(APPEND _neolip_asset_files "${_source}")
endforeach()
set(_source "${NEOLIP_BUNDLED_DICTIONARY_ROOT}/lexicon.tsv")
file(SHA256 "${_source}" _hash)
string(APPEND _neolip_hashes "dictionaries/lexicon.tsv:${_hash}\n")
string(APPEND _neolip_resources "_NEOLIP_DICTIONARIES_LEXICON_TSV RCDATA \"${_source}\"\n")
list(APPEND _neolip_asset_files "${_source}")
string(SHA256 _neolip_bundle_hash "${_neolip_hashes}")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/embedded_asset_hash.hpp"
    CONTENT "#define NEOLIP_BUNDLED_ASSET_HASH \"${_neolip_bundle_hash}\"\n")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/embedded_assets.rc" CONTENT "${_neolip_resources}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_neolip_asset_files})
set_property(SOURCE "${CMAKE_CURRENT_BINARY_DIR}/embedded_assets.rc"
    PROPERTY OBJECT_DEPENDS "${_neolip_asset_files}")
target_include_directories(neolip_core PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
target_compile_definitions(neolip_core PUBLIC NEOLIP_EMBEDDED_ASSETS)
foreach(_target NeoLIP neolip-cli)
    if(TARGET ${_target})
        target_sources(${_target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/embedded_assets.rc")
    endif()
endforeach()
