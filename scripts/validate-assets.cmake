cmake_minimum_required(VERSION 3.16)
if(NOT NEOLIP_PACKAGE_ROOT)
    message(FATAL_ERROR "NEOLIP_PACKAGE_ROOT is required")
endif()
set(_files models/phonemes_new_16k.train.spec models/phonemes_new_16k.parts
    dictionaries/lexicon.tsv)
foreach(_name manner place height)
    foreach(_ext _nnet.45 .train.spec .parts .map)
        list(APPEND _files "models/bc_16k/${_name}${_ext}")
    endforeach()
    foreach(_ext _nnet.45 .train.spec)
        list(APPEND _files "models/trans_16k/${_name}${_ext}")
    endforeach()
endforeach()
foreach(_relative IN LISTS _files)
    set(_path "${NEOLIP_PACKAGE_ROOT}/${_relative}")
    if(NOT EXISTS "${_path}" OR IS_DIRECTORY "${_path}")
        message(FATAL_ERROR "NeoLIP package is incomplete: ${_path}")
    endif()
    file(SIZE "${_path}" _size)
    if(_size EQUAL 0)
        message(FATAL_ERROR "NeoLIP package has an empty asset: ${_path}")
    endif()
endforeach()
message(STATUS "NeoLIP models and dictionary assets are present")
